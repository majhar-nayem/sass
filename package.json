{
  "name": "awning",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "gen:spec": "pnpm --filter @awning/spec gen",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @awning/db migrate",
    "db:reset": "pnpm --filter @awning/db reset",
    "db:seed": "pnpm --filter @awning/db seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "stock:ingest": "tsx scripts/ingest-stock.ts",
    "stock:validate": "tsx scripts/validate-stock.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^2",
    "tsx": "^4.19.2",
    "@awning/spec": "workspace:*",
    "@awning/db": "workspace:*",
    "@awning/integrations": "workspace:*",
    "sharp": "^0.33.5"
  }
}
