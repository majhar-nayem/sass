{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "generated/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "gen": {
      "outputs": [
        "generated/**"
      ],
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "SMTP_URL",
    "APP_URL",
    "SITES_ROOT_DOMAIN",
    "PREVIEW_BASE_URL",
    "BETTER_AUTH_SECRET",
    "CRON_SECRET",
    "OPS_EMAIL",
    "ANTHROPIC_API_KEY",
    "AI_DAILY_CEILING_CENTS",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_CONNECT_WEBHOOK_SECRET",
    "CF_API_TOKEN",
    "CF_ZONE_ID_SITES",
    "CF_ACCOUNT_ID",
    "CF_CNAME_TARGET",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "RESEND_API_KEY",
    "TURNSTILE_SECRET",
    "SENTRY_DSN",
    "LOCAL_STORAGE_DIR",
    "CDN_BASE_URL",
    "CANARY_BASE_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "LOG_LEVEL",
    "APP",
    "NEXT_RUNTIME"
  ]
}
