# Local development. Production secrets live in Fly secrets — never in a file.
DATABASE_URL="postgresql://awning:awning@localhost:5432/awning?schema=public"
DIRECT_URL="postgresql://awning:awning@localhost:5432/awning?schema=public"
# The request path connects as awning_app so RLS applies to it. Unset, dev falls back to
# DATABASE_URL; in production that fallback is refused at boot, because the owner role is
# RLS-exempt and the fallback would disable every tenant boundary at once.
APP_DATABASE_URL="postgresql://awning_app:awning_app@localhost:5432/awning?schema=public"
REDIS_URL="redis://localhost:6379"
SMTP_URL="smtp://localhost:1025"

APP_URL="http://localhost:3000"
SITES_ROOT_DOMAIN="awningsites.localhost"

ANTHROPIC_API_KEY=""
AI_DAILY_CEILING_CENTS="4000"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

CF_API_TOKEN=""
CF_ZONE_ID_SITES=""
CF_ACCOUNT_ID=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="awning-dev"

RESEND_API_KEY=""
TURNSTILE_SECRET=""
BETTER_AUTH_SECRET="dev-only-change-me-0123456789abcdef"
SENTRY_DSN=""

# Local object storage. Absolute on purpose: the dashboard and the renderer are separate
# processes with different working directories, so a cwd-relative default gives them two
# different stores and an uploaded image never appears on the site.
LOCAL_STORAGE_DIR=""
CDN_BASE_URL=""
PREVIEW_BASE_URL="http://localhost:3001"

# Shared secret for the scheduled sweep (domains + dunning).
CRON_SECRET=""
CF_CNAME_TARGET=""

# Where the 7am digest goes.
OPS_EMAIL=""
CANARY_BASE_URL=""
