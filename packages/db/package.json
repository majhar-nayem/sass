{
  "name": "@awning/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "migrate": "prisma migrate deploy && prisma generate",
    "pull": "prisma db pull && prisma generate",
    "reset": "prisma migrate reset --force --skip-seed && prisma generate",
    "studio": "prisma studio",
    "dev:roles": "psql \"$DATABASE_URL\" -c \"ALTER ROLE awning_app PASSWORD 'awning_app'\"",
    "build": "tsc --noEmit false --emitDeclarationOnly --outDir dist || true",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@awning/spec": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6",
    "vitest": "^2",
    "tsx": "^4.19.2"
  }
}
